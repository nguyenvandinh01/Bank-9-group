{
  "name": "bank9-tech",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Bank9 Tech - demo e-commerce for phones, laptops and PCs on Cloudflare Workers, D1 and R2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite dev",
    "predev": "node scripts/check-env.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "node scripts/check-deploy.mjs && npm run build && wrangler deploy",
    "deploy:check": "node scripts/check-deploy.mjs",
    "typecheck": "tsc -b",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply bank9-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply bank9-db --remote",
    "db:seed:local": "wrangler d1 execute bank9-db --local --file=./scripts/seed.sql",
    "db:seed:remote": "wrangler d1 execute bank9-db --remote --file=./scripts/seed.sql",
    "db:reset:local": "wrangler d1 execute bank9-db --local --file=./scripts/reset.sql",
    "seed:generate": "node scripts/generate-seed.mjs",
    "test": "vitest run",
    "test:oversell": "node scripts/test-oversell.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.4",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/workers-types": "^5.20261019.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  },
  "allowScripts": {
    "workerd@1.20261012.1": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
