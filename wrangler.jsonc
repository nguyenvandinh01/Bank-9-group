{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bank-9-group",
  "workers_dev": true,
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bank9-db",
      // Replace with the ID returned by: npx wrangler d1 create bank9-db
      // Kept as a placeholder so local dev works without a Cloudflare account.
      "database_id": "3fd821fc-0303-4990-8729-5d009e490ec3",
      "migrations_dir": "./migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "IMAGES",
      // Created with: npx wrangler kv namespace create bank9-images
      "id": "1ee0a7bf30524ba39d833a5037b04b7a"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "ENVIRONMENT": "production",
    "SHOP_NAME": "Bank9 Tech",
    "SESSION_TTL_HOURS": "12",
    "ORDER_HOLD_MINUTES": "30",
    "MAX_UPLOAD_BYTES": "3145728"
  }
}
